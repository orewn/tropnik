# Generate independent values, e.g. run openssl rand -hex 32 separately for each.
# Copy this file to .env; never commit or include real secrets in the archive.
POSTGRES_PASSWORD=
TROPA_APP_PASSWORD=
# Required stable 256-bit HMAC key for shared auth budgets. Server-only; changing
# it resets the identity namespace. All API replicas must use the same value.
TROPA_AUTH_RATE_KEY=
# Required independent 256-bit safety encryption key (hex or base64).
# All replicas need the same key. Back it up with the database: losing it makes
# existing private passports unreadable. Do not reuse auth/proxy credentials.
TROPA_SAFETY_DATA_KEY=
# Exact public browser origin, without a trailing slash. Required by both Go
# and the Next BFF at runtime; never inferred from incoming forwarding headers.
PUBLIC_ORIGIN=https://your-domain.example
# Optional pair: exact ingress/BFF peer CIDRs observed by Go plus a DIFFERENT
# 256-bit token shared by Caddy, Next BFF and Go. Configure both or neither.
# Caddy must overwrite X-Real-IP and X-Tropa-Proxy-Token. Never use NEXT_PUBLIC_*.
TRUSTED_PROXY_CIDRS=
TROPA_PROXY_TOKEN=

# Optional lifecycle mail. Leave all fields empty to keep new registration and
# verification/recovery link requests closed. Use compose.mail.yaml only after
# a real sender and HTTPS frontend are ready. Secrets remain server-only.
TROPA_SMTP_HOST=
TROPA_SMTP_PORT=
# tls = implicit TLS (commonly 465); starttls = mandatory upgrade (commonly 587).
TROPA_SMTP_TLS_MODE=
TROPA_SMTP_USERNAME=
TROPA_SMTP_PASSWORD=
TROPA_MAIL_FROM=
TROPA_ACCOUNT_ACTION_URL=
# Required with SMTP: independent stable 32-byte key encoded as 64 hex chars.
# Back up separately from PostgreSQL and reuse across all API replicas/restarts.
# Keep the key even with SMTP disabled while pending work exists. Losing or
# changing it with an encrypted backlog refuses startup; never reuse other keys.
TROPA_ACCOUNT_MAIL_KEY=
