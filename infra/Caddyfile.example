# Put the actual domain here after DNS is configured.
# This is the host HTTPS Caddy, outside the Compose HTTP ingress.
# Its loopback upstreams below are ports published by the ingress sidecar.
# Set TROPA_PROXY_TOKEN in this service environment as well as Next/Go.
# Both incoming forwarding headers are OVERWRITTEN, not appended or trusted.
# Go's TRUSTED_PROXY_CIDRS must include the actual ingress/Next peers on the
# internal application network. The sidecar receives no key and preserves headers.
your-domain.example {
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:8080 {
            header_up X-Real-IP {remote_host}
            header_up X-Tropa-Proxy-Token "{$TROPA_PROXY_TOKEN}"
        }
    }
    handle {
        reverse_proxy 127.0.0.1:3000 {
            header_up X-Real-IP {remote_host}
            header_up X-Tropa-Proxy-Token "{$TROPA_PROXY_TOKEN}"
        }
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }
}
