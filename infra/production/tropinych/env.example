# Production domain: Тропиныч.рф. Use its ASCII form in configuration.
# Copy to infra/.env on the VPS. This template intentionally contains no secrets.
# NEW installation only: an isolated Compose project; overrides name: tropa.
# For an existing installation, retain its original project name and volumes.
COMPOSE_PROJECT_NAME=tropinych
PUBLIC_ORIGIN=https://xn--h1akbedl4b5a.xn--p1ai
# Compose passes the same origin to Go, Next and the Next build/SEO metadata.
TROPA_PUBLIC_INDEXING=true

# Required: independent values, generated separately on the VPS.
# 64 hexadecimal characters are suitable for each. Preserve existing values
# when updating an installation; changing this file does not rotate DB roles.
POSTGRES_PASSWORD=
TROPA_APP_PASSWORD=
TROPA_AUTH_RATE_KEY=
TROPA_SAFETY_DATA_KEY=

# Optional pair. Configure both or neither. Use the observed ingress/Next peer
# CIDRs, not public client networks, and a separate 256-bit proof token.
# The host Caddy service must receive the same TROPA_PROXY_TOKEN via its own
# service environment; Docker's --env-file does not configure host Caddy.
TRUSTED_PROXY_CIDRS=
TROPA_PROXY_TOKEN=

# Optional account mail is disabled until a real sender is configured and
# compose.mail.yaml is included. Do not set only the action URL.
TROPA_SMTP_HOST=
TROPA_SMTP_PORT=
TROPA_SMTP_TLS_MODE=
TROPA_SMTP_USERNAME=
TROPA_SMTP_PASSWORD=
TROPA_MAIL_FROM=
TROPA_ACCOUNT_ACTION_URL=
TROPA_ACCOUNT_MAIL_KEY=
# With real SMTP, use this exact ASCII action URL:
# TROPA_ACCOUNT_ACTION_URL=https://xn--h1akbedl4b5a.xn--p1ai/account/action/
# TROPA_ACCOUNT_MAIL_KEY must be independent, stable and 64 hexadecimal chars.
